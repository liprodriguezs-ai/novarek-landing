{
  "name": "novarek-landing",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:production": "SITE_ENV=production PUBLIC_SITE_URL=https://novarek.mx astro build",
    "build:staging": "CLOUDFLARE_ENV=staging SITE_ENV=staging PUBLIC_SITE_URL=https://staging.novarek.mx astro build",
    "preview": "astro preview",
    "assert:deploy": "node scripts/assert-deploy-safe.mjs",
    "deploy:production": "npm run assert:deploy -- --expected-name novarek-landing-prod --env production && npm run build:production && wrangler deploy --env production",
    "deploy:staging": "npm run assert:deploy -- --expected-name novarek-landing-staging --env staging && npm run build:staging && wrangler deploy --env staging",
    "deploy": "npm run deploy:production",
    "astro": "astro",
    "check": "astro check"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tabler/icons": "^3.46.0",
    "astro": "^7.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1"
  }
}
