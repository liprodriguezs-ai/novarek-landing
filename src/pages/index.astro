---
import Layout from "../layouts/Layout.astro";
import { company } from "../config/company";

const problems = [
	"Tu equipo pierde tiempo copiando datos entre hojas, mensajes y sistemas.",
	"Las ventas, citas o solicitudes se atienden tarde porque todo depende de una persona.",
	"La información del negocio está dispersa y tomar decisiones se vuelve lento.",
	"Tienes un sistema que ya no se adapta a cómo trabaja tu empresa hoy.",
];

const solutions = [
	{
		title: "Sistemas internos",
		description: "Herramientas para controlar clientes, inventario, operaciones, reportes o procesos que hoy viven en archivos sueltos.",
	},
	{
		title: "Portales para clientes",
		description: "Espacios donde tus clientes pueden consultar avances, hacer solicitudes, agendar, pagar o dar seguimiento sin escribirte cada vez.",
	},
	{
		title: "Automatización de tareas",
		description: "Flujos que reducen captura manual, recordatorios, seguimiento y trabajo repetitivo para que tu equipo se enfoque en vender y atender.",
	},
	{
		title: "Sitios y apps a medida",
		description: "Experiencias digitales claras, rápidas y pensadas para convertir visitas en conversaciones, pedidos o clientes.",
	},
	{
		title: "Conexión entre herramientas",
		description: "Unimos las plataformas que ya usas para que la información viaje sola y no tengas que perseguir datos.",
	},
];

const outcomes = [
	"Menos tareas repetidas",
	"Más orden en la operación",
	"Mejor seguimiento a clientes",
	"Decisiones con información clara",
	"Procesos que no dependen de una sola persona",
	"Una solución hecha para tu forma real de trabajar",
];

const process = [
	{
		title: "Primero entendemos el problema",
		description: "Hablamos de tu operación, tus clientes y lo que hoy te quita tiempo. No empezamos con tecnología; empezamos con claridad.",
	},
	{
		title: "Después diseñamos el camino",
		description: "Definimos qué conviene construir primero, qué puede esperar y cómo entregar valor sin hacer el proyecto más grande de lo necesario.",
	},
	{
		title: "Construimos por etapas",
		description: "Avanzas viendo resultados. Probamos contigo, ajustamos lo importante y evitamos sorpresas hasta el final.",
	},
	{
		title: "Te acompañamos después",
		description: "Un buen sistema cambia con el negocio. Podemos mantenerlo, mejorarlo y sumar funciones conforme aparezcan nuevas necesidades.",
	},
];
---

<Layout title="Software a medida para ordenar y hacer crecer tu negocio | Novarek" description="Novarek crea sistemas, portales y automatizaciones para empresas que quieren trabajar con más orden, menos tareas manuales y mejor atención a clientes.">
	<header class="masthead">
		<a class="wordmark" href="#inicio" aria-label="Novarek Technologies, inicio">
			<img src={company.logo} width="56" height="56" alt="" />
			<span>NOVAREK</span>
		</a>
		<nav aria-label="Navegación principal">
			<a href="#problemas">Problemas</a>
			<a href="#soluciones">Soluciones</a>
			<a href="#proceso">Proceso</a>
		</nav>
		<a class="header-link" href="#contacto">Cuéntanos tu proyecto <span aria-hidden="true">↗</span></a>
	</header>

	<main>
		<section class="hero" id="inicio">
			<div class="hero-copy">
				<p class="intro-line">Software a medida para negocios que quieren trabajar mejor.</p>
				<h1>Creamos herramientas digitales que ordenan tu operación.</h1>
				<p class="hero-lede">Si tu empresa depende de hojas de cálculo, mensajes sueltos o procesos manuales, Novarek te ayuda a convertir ese desorden en un sistema claro, útil y fácil de usar.</p>
				<div class="hero-actions">
					<a class="primary-action" href="#contacto">Quiero mejorar mi operación</a>
					<a class="secondary-action" href="#soluciones">Ver qué podemos construir</a>
				</div>
			</div>
			<div class="hero-panel" aria-label="Resumen de beneficios">
				<p>Para empresas que necesitan:</p>
				<ul>
					<li>atender mejor a sus clientes</li>
					<li>reducir trabajo manual</li>
					<li>tener información más clara</li>
				</ul>
			</div>
		</section>

		<section class="problems" id="problemas">
			<div class="section-intro">
				<h2>Cuando el negocio crece, improvisar empieza a salir caro.</h2>
				<p>Muchas empresas no necesitan “más tecnología”. Necesitan que lo importante deje de perderse entre conversaciones, archivos y pendientes.</p>
			</div>
			<ul class="problem-list">
				{problems.map((problem) => <li>{problem}</li>)}
			</ul>
		</section>

		<section class="solutions" id="soluciones">
			<div class="section-intro wide">
				<h2>Construimos lo que tu operación realmente necesita.</h2>
				<p>No vendemos paquetes cerrados. Diseñamos contigo una solución que encaje con tu equipo, tus clientes y tu forma de trabajar.</p>
			</div>
			<div class="solution-grid">
				{solutions.map((solution) => <article class="solution-card"><h3>{solution.title}</h3><p>{solution.description}</p></article>)}
			</div>
		</section>

		<section class="outcomes">
			<div>
				<h2>El resultado no es “tener software”. Es trabajar con más control.</h2>
				<p>Una buena herramienta debe sentirse como una extensión natural del negocio: simple para el equipo, clara para los clientes y útil para tomar decisiones.</p>
			</div>
			<ul class="outcome-list">
				{outcomes.map((outcome) => <li>{outcome}</li>)}
			</ul>
		</section>

		<section class="process" id="proceso">
			<div class="section-intro">
				<h2>Un proceso claro, sin vueltas innecesarias.</h2>
				<p>Te acompañamos de la idea al lanzamiento con comunicación directa, entregas por etapas y decisiones entendibles.</p>
			</div>
			<ol class="process-list">
				{process.map((step) => <li><h3>{step.title}</h3><p>{step.description}</p></li>)}
			</ol>
		</section>

		<section class="trust">
			<h2>Hablamos claro, construimos con cuidado y cuidamos que el proyecto tenga sentido para tu negocio.</h2>
			<p>Si algo no conviene, lo decimos. Si hay una forma más simple de resolverlo, la buscamos. La meta es que inviertas en una herramienta que sí se use.</p>
		</section>

		<section class="contact" id="contacto">
			<div>
				<h2>Cuéntanos qué parte de tu operación necesita orden.</h2>
				<p>Respondemos con una conversación clara: qué se puede hacer, por dónde empezar y qué tendría más impacto primero.</p>
			</div>
			<a class="email" href={`mailto:${company.email}`}>{company.email}<span aria-hidden="true">↗</span></a>
		</section>
	</main>

	<footer>
		<span>© {company.year} Novarek Technologies</span>
		<span>Ciudad de México, MX</span>
		<a href={company.social.facebook} target="_blank" rel="noopener">Facebook ↗</a>
	</footer>
</Layout>
