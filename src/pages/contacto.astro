---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import { company } from "../config/company";
---

<Layout title="Contacto | Novarek" description="Cuéntanos tu proyecto de software, portal o automatización. Contacta a Novarek por formulario o escribe a contact@novarek.mx.">
	<header class="masthead contact-page-header">
		<a class="wordmark" href="/" aria-label="Novarek Technologies, inicio">
			<img src={company.logo} width="56" height="56" alt="" />
			<span>NOVAREK</span>
		</a>
		<a class="header-link" href="/">Volver al inicio</a>
	</header>
	<main>
		<section class="contact contact-page" id="contacto" aria-labelledby="contact-title">
			<div>
				<h1 id="contact-title">Cuéntanos tu proyecto.</h1>
				<p>Respondemos con una conversación clara: qué se puede hacer, por dónde empezar y qué tendría más impacto primero.</p>
				<a class="contact-email" href={`mailto:${company.email}`}>{company.email}</a>
			</div>
			<ContactForm />
		</section>
	</main>
	<footer>
		<span>© {company.year} Novarek Technologies</span>
		<span>Ciudad de México, MX</span>
		<a href={company.social.facebook} target="_blank" rel="noopener">Facebook ↗</a>
	</footer>
</Layout>
