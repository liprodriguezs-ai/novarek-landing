---
import { company } from "../config/company";
import Icon from "./Icon.astro";

const contactChannels = [
	{
		label: "Email",
		value: company.email,
		href: `mailto:${company.email}`,
		icon: "mail",
		external: false,
	},
	{
		label: "WhatsApp",
		value: company.whatsapp,
		href: company.whatsappLink,
		icon: "brand-whatsapp",
		external: true,
	},
	{
		label: "Ubicación",
		value: company.location,
		href: "",
		icon: "map-pin",
		external: false,
	},
];
---

<section id="contacto" class="section contact-section">
	<div class="container">
		<div class="contact-card">
			<div class="contact-grid">
				<div class="contact-copy">
					<h2>
						¿Listo para construir tu <span class="text-gradient">próximo sistema</span>?
					</h2>
					<p class="contact-desc">
						Cuéntanos tu idea. Coordinamos una llamada gratuita para analizar tu proyecto y
						darte una propuesta clara sin compromiso.
					</p>

					<div class="contact-channels">
						{
							contactChannels.map((c) =>
								c.href ? (
									<a
										class="channel"
										href={c.href}
										target={c.external ? "_blank" : undefined}
										rel={c.external ? "noopener" : undefined}
									>
										<span class="channel-icon" aria-hidden="true">
											<Icon name={c.icon} size={21} />
										</span>
										<span class="channel-body">
											<small>{c.label}</small>
											<strong>{c.value}</strong>
										</span>
									</a>
								) : (
									<div class="channel">
										<span class="channel-icon" aria-hidden="true">
											<Icon name={c.icon} size={21} />
										</span>
										<span class="channel-body">
											<small>{c.label}</small>
											<strong>{c.value}</strong>
										</span>
									</div>
								),
							)
						}
					</div>
				</div>

				<form class="contact-form" data-contact-form novalidate>
					<div class="field" data-field="name">
						<label for="name">Nombre</label>
						<input id="name" name="name" type="text" placeholder="Tu nombre" required />
						<small class="field-error" data-error hidden></small>
					</div>
					<div class="field" data-field="email">
						<label for="email">Email</label>
						<input id="email" name="email" type="email" placeholder="tu@correo.com" required />
						<small class="field-error" data-error hidden></small>
					</div>
					<div class="field" data-field="message">
						<label for="message">Cuéntanos tu proyecto</label>
						<textarea id="message" name="message" rows="4" placeholder="Describe brevemente tu idea o necesidad..." required></textarea>
						<small class="field-error" data-error hidden></small>
					</div>
					<button class="btn btn-primary form-submit" type="submit">
						Enviar mensaje
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<p class="form-note" data-form-note aria-live="polite"></p>
				</form>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-card {
		background: linear-gradient(160deg, var(--bg-panel) 0%, var(--bg-raised) 100%);
		border: 1px solid var(--border);
		border-radius: var(--radius-card);
		padding: clamp(1.8rem, 4vw, 3.2rem);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.contact-copy h2 {
		margin-bottom: 1rem;
	}

	.contact-desc {
		color: var(--text-secondary);
		margin-bottom: 2rem;
	}

	.contact-channels {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.channel {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.8rem 1rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.02);
		color: var(--text-primary);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.channel:hover {
		border-color: var(--border-strong);
		transform: translateX(4px);
		color: var(--text-primary);
	}

	.channel-icon {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		flex-shrink: 0;
		border-radius: 11px;
		background: var(--accent-soft);
		border: 1px solid var(--border-strong);
		color: var(--accent);
	}

	.channel-body {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}

	.channel-body small {
		font-size: 0.72rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	.channel-body strong {
		font-size: 0.98rem;
		font-weight: 500;
	}

	/* Form */
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.field label {
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--text-secondary);
		letter-spacing: 0.02em;
	}

	.field input,
	.field textarea {
		background: var(--bg-base);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 0.85rem 1rem;
		color: var(--text-primary);
		font-family: var(--font-body);
		font-size: 0.95rem;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
		resize: vertical;
	}

	.field input::placeholder,
	.field textarea::placeholder {
		color: var(--text-muted);
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(0, 217, 255, 0.12);
	}

	.field.invalid input,
	.field.invalid textarea {
		border-color: #ff5c8a;
	}

	.field-error {
		color: #ff5c8a;
		font-size: 0.8rem;
	}

	.form-submit {
		margin-top: 0.4rem;
	}

	.form-note {
		font-size: 0.86rem;
		color: var(--text-secondary);
		min-height: 1.2rem;
	}

	.form-note.success {
		color: var(--accent);
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
	const note = document.querySelector<HTMLElement>("[data-form-note]");

	function setError(field: HTMLElement, message: string) {
		const wrapper = field.closest("[data-field]");
		const errorEl = wrapper?.querySelector<HTMLElement>("[data-error]");
		if (!wrapper || !errorEl) return;
		if (message) {
			wrapper.classList.add("invalid");
			errorEl.textContent = message;
			errorEl.hidden = false;
		} else {
			wrapper.classList.remove("invalid");
			errorEl.hidden = true;
		}
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();

		const name = form.querySelector<HTMLInputElement>("#name");
		const email = form.querySelector<HTMLInputElement>("#email");
		const message = form.querySelector<HTMLTextAreaElement>("#message");

		if (!name || !email || !message) return;

		let valid = true;
		if (!name.value.trim()) {
			setError(name, "Escribe tu nombre.");
			valid = false;
		} else {
			setError(name, "");
		}

		const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
		if (!email.value.trim()) {
			setError(email, "Escribe tu correo.");
			valid = false;
		} else if (!emailOk) {
			setError(email, "Ese correo no parece válido.");
			valid = false;
		} else {
			setError(email, "");
		}

		if (!message.value.trim()) {
			setError(message, "Cuéntanos brevemente tu proyecto.");
			valid = false;
		} else {
			setError(message, "");
		}

		if (!valid) return;

		// TODO: conectar con tu backend, Formspree, EmailJS, etc.
		// Mientras tanto, abre WhatsApp con el mensaje y luego limpia el formulario.
		const text = encodeURIComponent(`Hola, me llamo ${name.value.trim()} (${email.value.trim()}).\n\n${message.value.trim()}`);
		window.open(`https://wa.me/?text=${text}`, "_blank");

		form.reset();
		if (note) {
			note.textContent = "Abrimos tu mensaje en WhatsApp. Gracias.";
			note.classList.add("success");
		}
	});
</script>